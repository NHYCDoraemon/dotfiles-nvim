# dotfiles — canonical ~/.zshrc  (symlinked here by install.sh)
# Single source of truth: edit this file in the repo, `git pull` propagates.
# Machine-specific values & secrets live in ~/.zshrc.local (gitignored, never committed).

# ----------------------------------------------------------------------------
# Oh My Zsh
# ----------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Prompt is rendered by starship (see shell/zshrc.snippet), so keep oh-my-zsh's
# own theme disabled. Leaving ZSH_THEME empty stops omz from drawing a prompt.
ZSH_THEME=""

# Plugin order matters:
#   fzf-tab                 must load AFTER compinit (oh-my-zsh handles it)
#   zsh-autosuggestions     ghost-text completions from history (gray inline)
#   zsh-syntax-highlighting MUST be the last entry — it hooks ZLE last
# All four custom plugins are cloned into $ZSH/custom/plugins by install.sh.
plugins=(git fzf-tab zsh-autosuggestions zsh-syntax-highlighting)

source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------------------------
# PATH + language toolchains
# ----------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"   # bun completions

# rust (rustup-installed binaries: rust-analyzer, rustfmt, clippy)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# go binaries (GOPATH/bin); GOPATH itself is exported in ~/.zprofile
typeset -U path
[ -d "$HOME/go/bin" ] && path=("$HOME/go/bin" $path[@])

# ----------------------------------------------------------------------------
# dotfiles shell extras — tool inits & aliases (eza/bat/fzf/zoxide/starship,
# nvd helper, .env loader). Source-of-truth: shell/zshrc.snippet in this repo.
# ----------------------------------------------------------------------------
[ -f "$HOME/.config/nvim/shell/zshrc.snippet" ] && . "$HOME/.config/nvim/shell/zshrc.snippet"

# ----------------------------------------------------------------------------
# Machine-specific overrides & secrets (NOT committed).
# Created from shell/zshrc.local.example by install.sh. Put API tokens, private
# project helper functions, per-machine PATH tweaks, etc. here.
# ----------------------------------------------------------------------------
[ -f "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"

# opencode
