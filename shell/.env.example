# dotfiles-nvim — local secrets / machine-specific env
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is .gitignored — never commit it.
#
# Loaded automatically by shell/zshrc.snippet on every interactive zsh start.
# Reload after edits with:  source ~/.zshrc
#
# Add entries as you need them. Examples (commented out):
#
# export ANTHROPIC_API_KEY="sk-ant-..."
# export OPENAI_API_KEY="sk-..."
# export GITHUB_TOKEN="ghp_..."
# export DEEPSEEK_API_KEY="..."
# export SILICONFLOW_API_KEY="sk-..."
